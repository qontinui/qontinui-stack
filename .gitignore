.env
*.log

# Per-session scratch (AWS provisioning artifacts, policy JSON drafts, etc.).
# Never commit — credentials and one-shot resources land here transiently.
tmp_*

# pg_dump artifacts from seeding the canonical PG from the legacy stack —
# can be hundreds of MB. Regenerate locally via scripts/seed-from-legacy.sh
# whenever needed; never commit.
seeds/

# Terraform state and per-environment overrides go in user's hands, not
# the repo. The aws/ tree's .gitignore should also catch state, but
# defending here too.
*.tfstate
*.tfstate.*
.terraform/

# Git-Bash crash dumps — never commit
*.stackdump

# Build secrets staged for `docker compose build coord` — the coord image
# clones the private qontinui-dev-notes repo and needs a GitHub PAT at
# /run/secrets/dn_token. Operator-held, never committed. Override the path
# with DN_TOKEN_FILE to keep the token outside the repo entirely.
secrets/
