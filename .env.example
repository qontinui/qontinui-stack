# Copy to .env and customize for your environment.
# All values shown are dev-only defaults — change for any non-local deployment.

# PostgreSQL
POSTGRES_USER=qontinui_user
POSTGRES_PASSWORD=qontinui_dev_password
POSTGRES_DB=qontinui_db
POSTGRES_PORT=5433

# Redis
REDIS_PORT=6380
REDIS_PASSWORD=qontinui_dev_redis

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9100
MINIO_CONSOLE_PORT=9101
# Phase 8 cold-tier PTY-output bucket (dev mirror of the staging
# session-output-cold S3 bucket). Created private by the minio-init sidecar.
SESSION_OUTPUT_COLD_BUCKET=qontinui-session-output-cold

# Coordinator service
COORD_PORT=9870
# GITHUB_WEBHOOK_SECRET=set-me-to-the-shared-secret-from-the-github-webhook
# COORD_RUST_LOG=qontinui_coord=debug,axum=debug,tower_http=info
# Cognito operator-bearer verification. docker-compose.yml defaults these to
# the production pool and production coord's own client lists
# (qontinui-coord deploy/taskdef.json); override only to point local coord at
# a different IdP (e.g. the hermetic local IdP). Keep the non-interactive set
# a subset of the audience — an accepted password-mintable client missing
# from it gets full write authority (the defaults knowingly keep two such
# clients interactive, as prod does — see docker-compose.yml).
# COORD_OIDC_ISSUER=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_rgTB9dbZ1
# COORD_OIDC_AUDIENCE=1r83igrltq3hfko2fnifhmjvvk,6k0mt7h1gk4raam66bpkcnlo9f,q6ns1a8bokf2np1mj8v8arl31,tb0epbojige1900ipu6q80j6b,7sirquecq6svomsoe34pblfp24,6j1gc0r988qu1g6qaou0pb4isb,67f2a1a0cmgileob23lniud5t7
# COORD_OIDC_NONINTERACTIVE_AUDIENCES=6k0mt7h1gk4raam66bpkcnlo9f,tb0epbojige1900ipu6q80j6b,7sirquecq6svomsoe34pblfp24
# Observer-only: password-mintable clients interactive by recorded decision,
# as <client_id>:<FLOW>[+<FLOW>] (reported, not alerted, while the live flows
# stay within the declared ones; grants and removes no authority).
# COORD_OIDC_INTERACTIVE_MINTABLE_AUDIENCES=6j1gc0r988qu1g6qaou0pb4isb:ALLOW_ADMIN_USER_PASSWORD_AUTH,67f2a1a0cmgileob23lniud5t7:ALLOW_USER_PASSWORD_AUTH
# COORD_SSO_DEFAULT_TENANT=default
# Device-JWT signing key. Defaults to a file on the persistent coord-mirrors
# volume, so it survives container recreates; `docker compose down -v` (or
# removing that volume) rotates it and invalidates every issued device JWT.
# COORD_JWT_KEY_PATH=/var/lib/qontinui-coord/mirrors/.coord-jwt-ed25519.pkcs8

# bazel-remote (content-addressed build cache; Row 10 Item 4)
# Backed by MinIO bucket BAZEL_REMOTE_BUCKET. HTTP port serves REST
# CAS/AC; gRPC port serves REAPI (reserved for Item 7+).
BAZEL_REMOTE_HTTP_PORT=9094
BAZEL_REMOTE_GRPC_PORT=9095
BAZEL_REMOTE_BUCKET=qontinui-bazel-remote
BAZEL_REMOTE_MAX_SIZE_GIB=50
BAZEL_REMOTE_S3_ENDPOINT=minio:9000
# Host-side URL the supervisor pool / canonical_diff_hash callers point at.
# In-stack consumers should use http://bazel-remote:80 instead.
BAZEL_REMOTE_HTTP_URL=http://localhost:9094
